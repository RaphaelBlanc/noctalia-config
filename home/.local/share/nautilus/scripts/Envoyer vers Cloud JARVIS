#!/usr/bin/env python3
"""Nautilus supplies one local path per argv element. No shell evaluation."""
from pathlib import Path
import os
import subprocess
import sys

files = sys.argv[1:] or os.environ.get('NAUTILUS_SCRIPT_SELECTED_FILE_PATHS', '').splitlines()
if files:
    subprocess.run([str(Path.home() / '.local/bin/nc-cloud'), 'deposer', *files], check=False)
